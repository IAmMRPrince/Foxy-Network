{
  "name": "foxy-network",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Open-source DePIN: share idle CPU and bandwidth, host web apps through reverse tunnels, relay an encrypted dVPN and earn $FOXY rewards.",
  "homepage": "https://iammrprince.github.io/Foxy-Network/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAmMRPrince/Foxy-Network.git"
  },
  "bugs": {
    "url": "https://github.com/IAmMRPrince/Foxy-Network/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start-all.js",
    "test": "node --test test/*.test.js packages/foxy-contracts/test/*.test.js",
    "donor": "npm --workspace=foxy-daemon start",
    "start:gateway": "npm --workspace=foxy-gateway start",
    "start:controller": "npm --workspace=foxy-controller start",
    "start:daemon": "npm --workspace=foxy-daemon start",
    "start:all": "node scripts/start-all.js",
    "compile:contracts": "npm --workspace=foxy-contracts run compile"
  },
  "keywords": [
    "depin",
    "decentralized-cloud",
    "reverse-tunnel",
    "edge-compute",
    "foxy-network",
    "dvpn",
    "vpn",
    "web3",
    "foxy-finance",
    "distributed-computing",
    "earn-crypto",
    "bandwidth-sharing",
    "decentralized-vpn",
    "proxy",
    "nodejs"
  ],
  "author": "Foxy Network Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
