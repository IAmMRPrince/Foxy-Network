{
  "name": "foxy-network",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Foxy Network - Decentralized Cloud Server Network & DePIN Engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start-all.js",
    "test": "node --test test/*.test.js packages/foxy-contracts/test/*.test.js",
    "donor": "npm --workspace=foxy-daemon start",
    "start:gateway": "npm --workspace=foxy-gateway start",
    "start:controller": "npm --workspace=foxy-controller start",
    "start:daemon": "npm --workspace=foxy-daemon start",
    "start:all": "node scripts/start-all.js",
    "compile:contracts": "npm --workspace=foxy-contracts run compile"
  },
  "keywords": [
    "depin",
    "decentralized-cloud",
    "reverse-tunnel",
    "edge-compute",
    "foxy-network",
    "dvpn",
    "vpn",
    "web3",
    "foxy-finance",
    "distributed-computing"
  ],
  "author": "Foxy Network Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "engines": {
    "node": ">=20"
  }
}
