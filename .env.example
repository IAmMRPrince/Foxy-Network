# =============================================================
# 🦊 Foxy Network — Variables de entorno
# Copia este archivo a .env y ajusta lo que necesites.
# NUNCA subas tu .env ni la carpeta .foxy/ a git.
# =============================================================

# --- Direcciones de los servicios ---
FOXY_GATEWAY_TUNNEL_URL=ws://127.0.0.1:8081
FOXY_GATEWAY_HTTP_PORT=8080
FOXY_GATEWAY_TUNNEL_PORT=8081
FOXY_CONTROLLER_URL=http://127.0.0.1:4000
FOXY_CONTROLLER_PORT=4000
FOXY_DAEMON_PORT=4040
# El panel del donante solo escucha en loopback. No lo cambies salvo que sepas lo que haces.
# FOXY_DAEMON_HOST=127.0.0.1

# --- Secretos (solo en el servidor del operador: controlador y gateway) ---
# Si los dejas vacíos se generan al azar en .foxy/ la primera vez.
# En producción, controlador y gateway deben compartir el mismo FOXY_NETWORK_SECRET.
# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FOXY_NETWORK_SECRET=
FOXY_ADMIN_KEY=
# Clave privada del oráculo que firma los vouchers de recompensa (¡independiente de las demás!)
FOXY_ORACLE_PRIVATE_KEY=

# --- Integración con Foxy Finance (API firmada) ---
FOXY_FINANCE_KEY_ID=foxy-finance
FOXY_FINANCE_API_SECRET=

# --- Liquidación on-chain (opcional; sin esto los reclamos son simulados) ---
# FOXY_TOKEN_ADDRESS=0x...
# FOXY_CHAIN_ID=84532

# --- Nodo donante ---
# Tipo de equipo para los beneficios de Foxy Finance: MOBILE | SBC | PC | SERVER
# FOXY_DEVICE_CLASS=PC
# FOXY_VPN_RELAY=off        # no ofrecer este equipo como salida dVPN
# FOXY_COMPUTE_JOBS=off     # no aceptar trabajos de cómputo
