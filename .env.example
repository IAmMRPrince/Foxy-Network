# =============================================================
# 🦊 Foxy Network — Variables de Entorno de Red
# =============================================================

# URL del Ingress Gateway (WebSocket Tunnel)
FOXY_GATEWAY_TUNNEL_URL=ws://127.0.0.1:8081

# Puerto HTTP público del Ingress Gateway
FOXY_GATEWAY_HTTP_PORT=8080

# URL del Orquestador / Control Plane
FOXY_CONTROLLER_URL=http://127.0.0.1:4000

# Puerto del Dashboard local del Donante
FOXY_DAEMON_PORT=4040

# Clave secreta compartida del cluster (para validación de tokens JWT)
FOXY_NETWORK_SECRET=foxy-depin-cluster-shared-secret-v1
